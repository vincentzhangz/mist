# API auth Secret. Copy to api-auth-secret.yaml (gitignored), fill in real
# values, and apply BEFORE the API rolls out:
#
#   cp deploy/api-auth-secret.example deploy/api-auth-secret.yaml
#   $EDITOR deploy/api-auth-secret.yaml
#   kubectl apply -f deploy/api-auth-secret.yaml
#
# Or create it imperatively (dev):
#
#   kubectl -n mist create secret generic mist-api-auth \
#     --from-literal=jwt-secret="$(openssl rand -hex 32)" \
#     --from-literal=admin-email=admin@example.com \
#     --from-literal=admin-password='change-me' \
#     --from-literal=ingest-token="$(openssl rand -hex 32)"
#
# Keys: jwt-secret is REQUIRED (the API refuses to start without it);
# admin-email/admin-password seed the dashboard login (absent/empty: login
# fails closed); ingest-token, when present, is required as the Bearer
# token on POST /api/ingest AND injected into agents via the monitor's
# apiTokenSecretName. ingest-tokens (comma-separated) accepts additional
# tokens: rotate by appending the new token, rolling the agents, then
# removing the old one. This file has no .yaml extension on purpose so a
# blind `kubectl apply -f deploy/` never installs placeholder credentials.
apiVersion: v1
kind: Secret
metadata:
  name: mist-api-auth
  namespace: mist
  labels:
    app.kubernetes.io/name: mist-api-auth
    app.kubernetes.io/part-of: mist
type: Opaque
stringData:
  jwt-secret: "REPLACE-WITH-openssl-rand-hex-32"
  admin-email: "admin@example.com"
  admin-password: "REPLACE-ME"
  ingest-token: "REPLACE-WITH-openssl-rand-hex-32"
  ingest-tokens: ""
