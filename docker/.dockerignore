# Rust build outputs (kept out of every image context).
target/
**/target/

# Trunk build output (rebuilt by CI; never baked into images).
crates/mist-dashboard/dist/

# eBPF build scratch (the .o is COPYed explicitly by name, never whole dirs).
*.o
*.d
# ...but the agent image bakes the prebuilt object (see docker/agent.Dockerfile).
!mist-ebpf.o

# Cargo lockfiles for scratch/vendor work (workspace Cargo.lock is committed).
.cargo/
vendor/

# Local env / secrets — never bake into an image.
.env
*.pem
*.key

# Editor and OS noise.
.git/
.gitignore
.idea/
.vscode/
*.swp
*~
.DS_Store

# Docs and CI stay out of the runtime image.
README.md
docs/
helm/
.github/
deploy/
